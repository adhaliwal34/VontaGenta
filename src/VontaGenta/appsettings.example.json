{
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": "Error",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "ApplicationDbContext": "Host=localhost;Database=your_db;Username=your_user;Password=your_password;"
  },
  "Emails": {
    "FromEmail": "no-reply@example.com"
  },
  "AWS": {
    "SES_SMTP_PORT": "587",
    "SES_SMTP_ENDPOINT": "email-smtp.us-east-1.amazonaws.com",
    "SES_SMTP_USERNAME": "your-ses-smtp-username",
    "SES_SMTP_PASSWORD": "your-ses-smtp-password"
  },
  "RegistrationEnabled": false,
  "Hcaptcha": {
    "Secret": "your-hcaptcha-secret"
  }
}
