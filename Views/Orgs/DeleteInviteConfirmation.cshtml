@model VontaGenta.Models.OrgInviteDeleteConfirmationViewModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this invite? The inviter will not be informed.</h3>
<div>
    <h4>Org Invite</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.OrgName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.OrgName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.OrgDescription)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.OrgDescription)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FromUserName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FromUserName)
        </dd>
    </dl>

    <form asp-action="DeleteInvite">
        <input type="hidden" asp-for="ID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
